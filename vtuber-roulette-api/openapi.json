  "components": {
    "schemas": {
      "CurrentRound": {
        "properties": {
          "round_id": {
            "type": "string",
            "title": "Round Id"
          },
          "result": {
            "$ref": "#/components/schemas/RouletteResult"
          },
          "selections": {
            "items": {
              "$ref": "#/components/schemas/SelectionGroup"
            },
            "type": "array",
            "title": "Selections"
          }
        },
        "type": "object",
        "required": [
          "round_id",
          "result",
          "selections"
        ],
        "title": "CurrentRound"
      },
      "DrawOption": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "standard_3",
              "standard_4",
              "hosts_vs_duo",
              "hosts_split_pairs"
            ],
            "title": "Mode"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "unavailable_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unavailable Reason"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "available",
          "unavailable_reason"
        ],
        "title": "DrawOption"
      },
      "DrawRecord": {
        "properties": {
          "round_id": {
            "type": "string",
            "title": "Round Id"
          },
          "drawn_at": {
            "type": "string",
            "title": "Drawn At"
          },
          "result": {
            "$ref": "#/components/schemas/RouletteResult"
          },
          "selected": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Selected"
          },
          "organizers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Organizers"
          },
          "participants": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Participants"
          },
          "reasons": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Reasons",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "round_id",
          "drawn_at",
          "result",
          "selected",
          "organizers",
          "participants"
        ],
        "title": "DrawRecord"
      },
      "DrawRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "standard_3",
              "standard_4",
              "hosts_vs_duo",
              "hosts_split_pairs"
            ],
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "DrawRequest"
      },
      "DrawResponse": {
        "properties": {
          "round_id": {
            "type": "string",
            "title": "Round Id"
          }
        },
        "type": "object",
        "required": [
          "round_id"
        ],
        "title": "DrawResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Organizer": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "type": "object",
        "required": [
          "name",
          "active"
        ],
        "title": "Organizer"
      },
      "ParticipantRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ParticipantRequest"
      },
      "ParticipantStatus": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "participation_count": {
            "type": "integer",
            "title": "Participation Count"
          },
          "miss_count": {
            "type": "integer",
            "title": "Miss Count"
          },
          "forced": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "any",
                  "A",
                  "B"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Forced"
          },
          "excluded": {
            "type": "boolean",
            "title": "Excluded"
          },
          "auto_forced": {
            "type": "boolean",
            "title": "Auto Forced"
          },
          "due": {
            "type": "boolean",
            "title": "Due"
          }
        },
        "type": "object",
        "required": [
          "name",
          "participation_count",
          "miss_count",
          "forced",
          "excluded",
          "auto_forced",
          "due"
        ],
        "title": "ParticipantStatus"
      },
      "ReplaceParticipantsRequest": {
        "properties": {
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Names"
          }
        },
        "type": "object",
        "required": [
          "names"
        ],
        "title": "ReplaceParticipantsRequest"
      },
      "ResultTeam": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "players": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Players"
          }
        },
        "type": "object",
        "required": [
          "label",
          "players"
        ],
        "title": "ResultTeam"
      },
      "Revision": {
        "properties": {
          "instance_id": {
            "type": "string",
            "title": "Instance Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "instance_id",
          "version"
        ],
        "title": "Revision"
      },
      "RouletteResult": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "standard_3",
              "standard_4",
              "hosts_vs_duo",
              "hosts_split_pairs"
            ],
            "title": "Kind"
          },
          "teams": {
            "items": {
              "$ref": "#/components/schemas/ResultTeam"
            },
            "type": "array",
            "title": "Teams"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "teams"
        ],
        "title": "RouletteResult"
      },
      "SaveOrganizersRequest": {
        "properties": {
          "organizer_mode": {
            "type": "string",
            "enum": [
              "single",
              "double"
            ],
            "title": "Organizer Mode"
          },
          "organizers": {
            "items": {
              "$ref": "#/components/schemas/Organizer"
            },
            "type": "array",
            "title": "Organizers"
          }
        },
        "type": "object",
        "required": [

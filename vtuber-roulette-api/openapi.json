          "organizers"
        ],
        "title": "SaveOrganizersRequest"
      },
      "SaveSettingsRequest": {
        "properties": {
          "miss_threshold": {
            "type": "integer",
            "title": "Miss Threshold"
          },
          "enable_auto_force": {
            "type": "boolean",
            "title": "Enable Auto Force"
          }
        },
        "type": "object",
        "required": [
          "miss_threshold",
          "enable_auto_force"
        ],
        "title": "SaveSettingsRequest"
      },
      "SelectionGroup": {
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "manual_check",
              "miss_3",
              "median_gap",
              "random",
              "exception_prev_round"
            ],
            "title": "Reason"
          },
          "players": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Players"
          }
        },
        "type": "object",
        "required": [
          "reason",
          "players"
        ],
        "title": "SelectionGroup"
      },
      "SessionState": {
        "properties": {
          "revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "presentation_duration_ms": {
            "type": "integer",
            "title": "Presentation Duration Ms"
          },
          "organizer_mode": {
            "type": "string",
            "enum": [
              "single",
              "double"
            ],
            "title": "Organizer Mode"
          },
          "organizers": {
            "items": {
              "$ref": "#/components/schemas/Organizer"
            },
            "type": "array",
            "title": "Organizers"
          },
          "participants": {
            "items": {
              "$ref": "#/components/schemas/ParticipantStatus"
            },
            "type": "array",
            "title": "Participants"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "draw_options": {
            "items": {
              "$ref": "#/components/schemas/DrawOption"
            },
            "type": "array",
            "title": "Draw Options"
          },
          "current_round": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CurrentRound"
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_round_players": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Previous Round Players"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/DrawRecord"
            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "revision",
          "presentation_duration_ms",
          "organizer_mode",
          "organizers",
          "participants",
          "settings",
          "draw_options",
          "current_round",
          "previous_round_players",
          "history"
        ],
        "title": "SessionState"
      },
      "SetExcludedRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "excluded": {
            "type": "boolean",
            "title": "Excluded"
          }
        },
        "type": "object",
        "required": [
          "name",
          "excluded"
        ],
        "title": "SetExcludedRequest"
      },
      "SetForcedRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "forced": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "any",
                  "A",
                  "B"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Forced"
          }
        },
        "type": "object",
        "required": [
          "name",
          "forced"
        ],
        "title": "SetForcedRequest"
      },
      "Settings": {
        "properties": {
          "miss_threshold": {
            "type": "integer",
            "title": "Miss Threshold"
          },
          "enable_auto_force": {
            "type": "boolean",
            "title": "Enable Auto Force"
          },
          "forced_limit": {
            "type": "integer",
            "title": "Forced Limit"
          }
        },
        "type": "object",
        "required": [
          "miss_threshold",
          "enable_auto_force",
          "forced_limit"
        ],
        "title": "Settings"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

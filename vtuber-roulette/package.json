{
  "name": "vtuber-roulette",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../vtuber-roulette-api/openapi.json -o src/api/schema.ts",
    "start": "vite",
    "build": "npm run gen:api && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
